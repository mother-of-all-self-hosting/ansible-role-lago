[Unit]
Description=Lago Front ({{ lago_front_identifier }})
{% for service in lago_front_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in lago_front_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ lago_front_container_cleanup_command | trim | replace("\n", " ") }}'

{#
  Not using `--read-only` or a `--user` because of:
  > touch: ./env-config.js: Read-only file system
  > ./.env.sh: line 12: ./env-config.js: Read-only file system
#}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ lago_front_identifier }} \
      --log-driver=none \
      --network={{ lago_front_container_network }} \
      {% if lago_front_container_http_host_bind_port %}
      -p {{ lago_front_container_http_host_bind_port }}:{{ lago_front_container_http_port }} \
      {% endif %}
      --env-file={{ lago_front_base_path }}/env \
      --label-file={{ lago_front_base_path }}/labels \
      {% for volume in lago_front_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for arg in lago_front_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ lago_front_container_image }}

{% for network in lago_front_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ lago_front_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ lago_front_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ lago_front_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ lago_front_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ lago_front_identifier }}

[Install]
WantedBy=multi-user.target
